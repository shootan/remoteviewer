<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Selected: a tinted fill with an accent border, not an accent fill. White on ui_accent is
         2.95:1 (below the 4.5:1 floor); on ui_accent_container it is 10.46:1, and the border is
         3.54:1 against the fill (non-text, 3:1 floor). .claude/apk_ui_contrast.py -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_accent_container" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/ui_accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_surface_raised" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/ui_divider" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_surface" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/ui_divider" />
        </shape>
    </item>
</selector>
