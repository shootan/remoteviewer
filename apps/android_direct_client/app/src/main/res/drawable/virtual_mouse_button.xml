<?xml version="1.0" encoding="utf-8"?>
<!-- Deliberately translucent: the widget sits on top of the remote screen and has to be
     usable without hiding what is underneath it. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#D93A4A63" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#B3C8D2E6" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#A61A1F2B" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#66C8D2E6" />
        </shape>
    </item>
</selector>
