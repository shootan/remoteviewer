<?xml version="1.0" encoding="utf-8"?>
<!-- Hollow, so the remote cursor and whatever it is over remain visible inside it. Two rings in
     contrasting shades so it reads against both light and dark remote screens. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke android:width="3dp" android:color="#CC101418" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="#FF6FE38A" />
        </shape>
    </item>
</layer-list>
