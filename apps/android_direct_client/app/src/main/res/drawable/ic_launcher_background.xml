<?xml version="1.0" encoding="utf-8"?>
<!-- Soft mint-to-sky wash. Adaptive icons get cropped to whatever shape the launcher uses, so
     the background carries no detail near the edges - only colour. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:color="#FF8FE0C8" android:offset="0.0" />
                <item android:color="#FF6FC9DE" android:offset="0.55" />
                <item android:color="#FF7FB6EA" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
