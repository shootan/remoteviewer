<?xml version="1.0" encoding="utf-8"?>
<!-- apk-ui r2: the app's ordinary button on the dark tokens. Selected is the current tab or choice
     (tinted fill + accent border); disabled keeps its shape but drops the border. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_surface" />
            <corners android:radius="@dimen/ui_corner_button" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_accent_container" />
            <stroke android:width="1dp" android:color="@color/ui_divider" />
            <corners android:radius="@dimen/ui_corner_button" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_accent_container" />
            <stroke android:width="2dp" android:color="@color/ui_accent" />
            <corners android:radius="@dimen/ui_corner_button" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_surface_raised" />
            <stroke android:width="2dp" android:color="@color/ui_accent" />
            <corners android:radius="@dimen/ui_corner_button" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_surface_raised" />
            <stroke android:width="1dp" android:color="@color/ui_divider" />
            <corners android:radius="@dimen/ui_corner_button" />
        </shape>
    </item>
</selector>
