<?xml version="1.0" encoding="utf-8"?>
<!-- apk-ui r2: text fields on the dark tokens; focus is an accent border. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_bg" />
            <stroke android:width="2dp" android:color="@color/ui_accent" />
            <corners android:radius="@dimen/ui_corner_button" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ui_bg" />
            <stroke android:width="1dp" android:color="@color/ui_divider" />
            <corners android:radius="@dimen/ui_corner_button" />
        </shape>
    </item>
</selector>
