<?xml version="1.0" encoding="utf-8"?>
<!-- The macro window: record, then review what was captured, then play it back. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/viewer_log_dialog_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/macro_title"
            android:textColor="#F4F0E8"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/macroRecordButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/viewer_control_button_background"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/macro_record"
            android:textAllCaps="false"
            android:textColor="#FF8A8A"
            android:textSize="13sp" />

        <Button
            android:id="@+id/macroCloseButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/viewer_control_button_background"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/key_panel_close"
            android:textAllCaps="false"
            android:textColor="#F4F0E8"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/macroStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#9AA3B2"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:scrollbars="vertical">

        <!-- One row per action, built in code; tapping a row opens the edit dialog. -->
        <LinearLayout
            android:id="@+id/macroStepListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Playback settings. Exact repetition is rarely what is wanted: identical timing hides
         races that a small variation would surface. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/macro_repeat_label"
                android:textColor="#9AA3B2"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/macroRepeatInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_input_background"
                android:inputType="number"
                android:maxLines="1"
                android:padding="8dp"
                android:text="1"
                android:textColor="#1A1A1A"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/macro_gap_label"
                android:textColor="#9AA3B2"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/macroGapMinInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/panel_input_background"
                    android:inputType="number"
                    android:maxLines="1"
                    android:padding="8dp"
                    android:text="500"
                    android:textColor="#1A1A1A"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/macroGapMaxInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/panel_input_background"
                    android:inputType="number"
                    android:maxLines="1"
                    android:padding="8dp"
                    android:text="1500"
                    android:textColor="#1A1A1A"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/macro_timing_jitter_label"
                android:textColor="#9AA3B2"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/macroTimingJitterInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_input_background"
                android:inputType="number"
                android:maxLines="1"
                android:padding="8dp"
                android:text="40"
                android:textColor="#1A1A1A"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/macro_position_jitter_label"
                android:textColor="#9AA3B2"
                android:textSize="11sp" />

            <EditText
                android:id="@+id/macroPositionJitterInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_input_background"
                android:inputType="number"
                android:maxLines="1"
                android:padding="8dp"
                android:text="2"
                android:textColor="#1A1A1A"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/macroPlayButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/viewer_control_button_background"
            android:text="@string/macro_play"
            android:textAllCaps="false"
            android:textColor="#F4F0E8"
            android:textSize="13sp" />

        <Button
            android:id="@+id/macroPauseButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/viewer_control_button_background"
            android:text="@string/macro_pause"
            android:textAllCaps="false"
            android:textColor="#F4F0E8"
            android:textSize="13sp" />

        <Button
            android:id="@+id/macroClearButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/viewer_control_button_background"
            android:text="@string/macro_clear"
            android:textAllCaps="false"
            android:textColor="#F4F0E8"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/macroSaveButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/viewer_control_button_background"
            android:text="@string/macro_save"
            android:textAllCaps="false"
            android:textColor="#F4F0E8"
            android:textSize="13sp" />

        <Button
            android:id="@+id/macroLoadButton"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/viewer_control_button_background"
            android:text="@string/macro_load"
            android:textAllCaps="false"
            android:textColor="#F4F0E8"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
