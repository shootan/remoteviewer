<?xml version="1.0" encoding="utf-8"?>
<!--
  On-screen mouse, anchored to the pointer.

  Fills the video frame but consumes nothing itself, so touches that miss the marker and the
  button cluster still reach the picture underneath. The two pieces are positioned separately in
  code: the marker sits exactly on the remote pointer, and the cluster sits beside it, pushed
  back inside the frame when the pointer is near an edge. Keeping them apart is what lets the
  cluster stay reachable while the pointer goes right to the corner.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/viewerVirtualMouse"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <!-- An arrow, positioned by its tip. That tip is the pixel a click lands on, so it is what
         the user aims with. -->
    <View
        android:id="@+id/virtualMousePointer"
        android:layout_width="26dp"
        android:layout_height="40dp"
        android:background="@drawable/virtual_mouse_cursor" />

    <RelativeLayout
        android:id="@+id/virtualMouseCluster"
        android:layout_width="196dp"
        android:layout_height="196dp">

        <TextView
            android:id="@+id/virtualMouseRoll"
            android:layout_width="76dp"
            android:layout_height="46dp"
            android:layout_centerHorizontal="true"
            android:background="@drawable/virtual_mouse_button"
            android:gravity="center"
            android:text="@string/virtual_mouse_roll"
            android:textColor="#F4F0E8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/virtualMouseLeft"
            android:layout_width="58dp"
            android:layout_height="68dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/virtual_mouse_button"
            android:gravity="center"
            android:text="@string/virtual_mouse_left"
            android:textColor="#F4F0E8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/virtualMouseRight"
            android:layout_width="58dp"
            android:layout_height="68dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/virtual_mouse_button"
            android:gravity="center"
            android:text="@string/virtual_mouse_right"
            android:textColor="#F4F0E8"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/virtualMouseMiddle"
            android:layout_width="76dp"
            android:layout_height="46dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:background="@drawable/virtual_mouse_button"
            android:gravity="center"
            android:text="@string/virtual_mouse_middle"
            android:textColor="#F4F0E8"
            android:textSize="12sp" />

        <!-- Drag this and the pointer, the marker and this whole cluster travel together. -->
        <TextView
            android:id="@+id/virtualMousePad"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_centerInParent="true"
            android:background="@drawable/virtual_mouse_pad"
            android:gravity="center"
            android:text="@string/virtual_mouse_pad"
            android:textColor="#F4F0E8"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/virtualMouseClose"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:background="@drawable/virtual_mouse_button"
            android:gravity="center"
            android:text="@string/virtual_mouse_close"
            android:textColor="#F4F0E8"
            android:textSize="15sp" />
    </RelativeLayout>
</FrameLayout>
