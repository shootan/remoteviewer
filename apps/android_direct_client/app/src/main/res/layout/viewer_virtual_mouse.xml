<?xml version="1.0" encoding="utf-8"?>
<!--
  On-screen mouse for precise work.

  A fingertip covers far more than one pixel, so tapping a 16px close button or a scrollbar is
  guesswork. Here the pointer is moved by dragging the centre pad, at a fraction of the finger's
  speed, and the click happens on a button afterwards - so the aim never shifts at the moment of
  clicking. The whole widget can be dragged out of the way by its handle.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/viewerVirtualMouse"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:visibility="gone">

    <RelativeLayout
        android:layout_width="220dp"
        android:layout_height="220dp">

        <!-- Wheel. Drag it rather than tapping: a wheel is a continuous control. -->
        <TextView
            android:id="@+id/virtualMouseRoll"
            android:layout_width="86dp"
            android:layout_height="52dp"
            android:layout_centerHorizontal="true"
            android:background="@drawable/virtual_mouse_button"
            android:gravity="center"
            android:text="@string/virtual_mouse_roll"
            android:textColor="#F4F0E8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/virtualMouseLeft"
            android:layout_width="62dp"
            android:layout_height="76dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/virtual_mouse_button"
            android:gravity="center"
            android:text="@string/virtual_mouse_left"
            android:textColor="#F4F0E8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/virtualMouseRight"
            android:layout_width="62dp"
            android:layout_height="76dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/virtual_mouse_button"
            android:gravity="center"
            android:text="@string/virtual_mouse_right"
            android:textColor="#F4F0E8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/virtualMouseMiddle"
            android:layout_width="86dp"
            android:layout_height="52dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:background="@drawable/virtual_mouse_button"
            android:gravity="center"
            android:text="@string/virtual_mouse_middle"
            android:textColor="#F4F0E8"
            android:textSize="13sp" />

        <!-- Centre: drag to steer the remote pointer. -->
        <TextView
            android:id="@+id/virtualMousePad"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_centerInParent="true"
            android:background="@drawable/virtual_mouse_pad"
            android:gravity="center"
            android:text="@string/virtual_mouse_pad"
            android:textColor="#F4F0E8"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/virtualMouseClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:background="@drawable/virtual_mouse_button"
            android:gravity="center"
            android:text="@string/virtual_mouse_close"
            android:textColor="#F4F0E8"
            android:textSize="16sp" />

        <!-- Moves the widget itself, so it can be pushed off whatever it is covering. -->
        <TextView
            android:id="@+id/virtualMouseHandle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:background="@drawable/virtual_mouse_button"
            android:gravity="center"
            android:text="@string/virtual_mouse_handle"
            android:textColor="#F4F0E8"
            android:textSize="16sp" />
    </RelativeLayout>
</FrameLayout>
