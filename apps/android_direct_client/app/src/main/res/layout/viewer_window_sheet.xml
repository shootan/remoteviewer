<?xml version="1.0" encoding="utf-8"?>
<!-- apk-ui r1: switching windows without leaving the viewer (Codex 2). The current target carries a
     check; loading / empty / failed / switching each say so in the status line. Clickable over the
     whole overlay: nothing here reaches the remote PC. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/viewerWindowOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_scrim"
    android:clickable="true"
    android:focusable="false"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/viewerWindowSheet"
        android:layout_width="@dimen/ui_sheet_side_width"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/ui_sheet_side_background"
        android:clickable="true"
        android:elevation="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ui_windows_title"
                android:textColor="@color/ui_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/viewerWindowRefreshButton"
                style="@style/UiIconButton"
                android:contentDescription="@string/ui_refresh"
                android:src="@drawable/ic_ui_refresh" />

            <ImageButton
                android:id="@+id/viewerWindowCloseButton"
                style="@style/UiIconButton"
                android:contentDescription="@string/ui_close"
                android:src="@drawable/ic_ui_close" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="32dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ProgressBar
                android:id="@+id/viewerWindowProgress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:indeterminateTint="@color/ui_accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/viewerWindowStatusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/ui_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <ListView
            android:id="@+id/viewerWindowList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="4dp"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:clipToPadding="false"
            android:scrollbarStyle="outsideOverlay" />
    </LinearLayout>
</FrameLayout>
