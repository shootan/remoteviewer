<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F3EE">

    <ScrollView
        android:id="@+id/loginScene"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_title"
                android:textColor="#1A1A1A"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/login_subtitle"
                android:textColor="#666666"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/loginServerInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/panel_input_background"
                android:hint="@string/login_server_hint"
                android:inputType="textUri"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="#1A1A1A"
                android:textColorHint="#777777" />

            <EditText
                android:id="@+id/loginIdInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/panel_input_background"
                android:hint="@string/login_id_hint"
                android:inputType="text"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="#1A1A1A"
                android:textColorHint="#777777" />

            <EditText
                android:id="@+id/loginPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/panel_input_background"
                android:hint="@string/login_password_hint"
                android:inputType="textPassword"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="#1A1A1A"
                android:textColorHint="#777777" />

            <Button
                android:id="@+id/loginButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/panel_button_background"
                android:textColor="@color/panel_button_text"
                android:text="@string/login_button" />

            <TextView
                android:id="@+id/loginErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:maxLines="3"
                android:textColor="#B00020" />

            <Button
                android:id="@+id/loginManualButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/panel_button_background"
                android:textColor="@color/panel_button_text"
                android:text="@string/login_manual_button" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/hostsScene"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hostsTitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/hosts_title"
                android:textColor="#1A1A1A"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/hostsRefreshButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_button_background"
                android:textColor="@color/panel_button_text"
                android:text="@string/refresh_button" />

            <Button
                android:id="@+id/hostsLogoutButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/panel_button_background"
                android:textColor="@color/panel_button_text"
                android:text="@string/hosts_logout_button" />
        </LinearLayout>

        <TextView
            android:id="@+id/hostsStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxLines="2"
            android:textColor="#666666"
            android:textSize="13sp" />

        <ListView
            android:id="@+id/hostsListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="8dp" />

        <TextView
            android:id="@+id/hostsEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/hosts_empty"
            android:textColor="#666666" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/connectScene"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/shell_title"
            android:textColor="#1A1A1A"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/shell_subtitle"
            android:textColor="#666666"
            android:textSize="13sp" />

            <EditText
                android:id="@+id/hostInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/panel_input_background"
                android:hint="@string/host_hint"
                android:inputType="textUri"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="#1A1A1A"
                android:textColorHint="#777777"
                android:text="192.168.0.10" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/videoPortInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_input_background"
                android:layout_weight="1"
                android:hint="@string/video_port_hint"
                android:inputType="number"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="#1A1A1A"
                android:textColorHint="#777777"
                android:text="43000" />

            <EditText
                android:id="@+id/controlPortInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/panel_input_background"
                android:layout_weight="1"
                android:hint="@string/control_port_hint"
                android:inputType="number"
                android:maxLines="1"
                android:padding="12dp"
                android:textColor="#1A1A1A"
                android:textColorHint="#777777"
                android:text="43001" />
        </LinearLayout>

        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/panel_button_background"
            android:textColor="@color/panel_button_text"
            android:text="@string/connect_button" />

        <TextView
            android:id="@+id/connectStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#1A1A1A"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/connectErrorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="#B00020" />
    </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/targetsScene"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/targets_title"
                android:textColor="#1A1A1A"
                android:textSize="24sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/listDisconnectButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/panel_button_background"
                android:textColor="@color/panel_button_text"
                android:text="@string/disconnect_button" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/listWindowsButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/panel_button_background"
                android:textColor="@color/panel_button_text"
                android:text="@string/target_windows_button" />

            <Button
                android:id="@+id/listDevicesButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/panel_button_background"
                android:textColor="@color/panel_button_text"
                android:text="@string/target_desktop_button" />

            <Button
                android:id="@+id/listSettingsButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/panel_button_background"
                android:textColor="@color/panel_button_text"
                android:text="@string/target_settings_button" />
        </LinearLayout>

        <Button
            android:id="@+id/listRefreshButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:background="@drawable/panel_button_background"
            android:textColor="@color/panel_button_text"
            android:text="@string/refresh_button" />

        <TextView
            android:id="@+id/listSelectedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1A1A1A"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/listStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#666666"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/settingsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel_input_background"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_title"
                android:textColor="#1A1A1A"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/settings_hint"
                android:textColor="#666666"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/settings_desktop_backend_label"
                android:textColor="#1A1A1A"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/settings_desktop_backend_hint"
                android:textColor="#666666"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/settingsDesktopBackendDxgiButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/panel_button_background"
                    android:text="@string/settings_desktop_backend_dxgi"
                    android:textColor="@color/panel_button_text" />

                <Button
                    android:id="@+id/settingsDesktopBackendWgcButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/panel_button_background"
                    android:text="@string/settings_desktop_backend_wgc"
                    android:textColor="@color/panel_button_text" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/settingsBitrateInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#F5F3EE"
                    android:hint="@string/settings_bitrate_hint"
                    android:inputType="number"
                    android:maxLines="1"
                    android:padding="12dp"
                    android:textColor="#1A1A1A"
                    android:textColorHint="#777777"
                    android:text="8000" />

                <EditText
                    android:id="@+id/settingsFpsInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="#F5F3EE"
                    android:hint="@string/settings_fps_hint"
                    android:inputType="number"
                    android:maxLines="1"
                    android:padding="12dp"
                    android:textColor="#1A1A1A"
                    android:textColorHint="#777777"
                    android:text="30" />
            </LinearLayout>

            <Button
                android:id="@+id/settingsApplyButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/panel_button_background"
                android:text="@string/settings_apply_button"
                android:textColor="@color/panel_button_text" />

            <TextView
                android:id="@+id/settingsAppliedText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/settings_apply_idle"
                android:textColor="#666666"
                android:textSize="12sp" />
        </LinearLayout>

        <GridView
            android:id="@+id/targetListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:horizontalSpacing="10dp"
            android:listSelector="@android:color/transparent"
            android:numColumns="auto_fit"
            android:columnWidth="164dp"
            android:stretchMode="columnWidth"
            android:verticalSpacing="10dp" />

        <TextView
            android:id="@+id/targetListEmptyText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="#666666"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Viewer: the video gets its own box and the controls sit in a rail beside it, so a
         button never covers the remote screen. The split flips orientation with the device. -->
    <LinearLayout
        android:id="@+id/viewerScene"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#050505"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/viewerSplit"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/viewerVideoFrame"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <TextureView
                    android:id="@+id/videoTextureView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.remote60.androiddirect.ImeCaptureView
                    android:id="@+id/viewerImeCaptureView"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:layout_gravity="top|end"
                    android:alpha="0.01" />

                <LinearLayout
                    android:id="@+id/viewerLoadingPanel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:background="@drawable/viewer_log_dialog_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="28dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="28dp"
                    android:paddingBottom="24dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/viewerLoadingSpinner"
                        style="?android:attr/progressBarStyle"
                        android:layout_width="48dp"
                        android:layout_height="48dp" />

                    <TextView
                        android:id="@+id/viewerLoadingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="3"
                        android:maxWidth="280dp"
                        android:textColor="#F2F2F2"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/viewerOverlayStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="#66000000"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:padding="12dp"
                    android:textColor="#F2F2F2"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/viewerControlsBar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="#12151C"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingTop="10dp"
                android:paddingEnd="6dp"
                android:paddingBottom="10dp">

                <Button
                    android:id="@+id/viewerBackButton"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:background="@drawable/viewer_control_button_background"
                    android:minWidth="0dp"
                    android:text="@string/viewer_back_button"
                    android:textAllCaps="false"
                    android:textColor="#F4F0E8"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/viewerKeyboardButton"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/viewer_control_button_background"
                    android:contentDescription="@string/viewer_keyboard_description"
                    android:minWidth="0dp"
                    android:text="@string/viewer_keyboard_button"
                    android:textAllCaps="false"
                    android:textColor="#F4F0E8"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/viewerScrollButton"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/viewer_control_button_background"
                    android:contentDescription="@string/viewer_scroll_description"
                    android:minWidth="0dp"
                    android:text="@string/viewer_scroll_button"
                    android:textAllCaps="false"
                    android:textColor="#F4F0E8"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/viewerKeysButton"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/viewer_control_button_background"
                    android:contentDescription="@string/key_panel_description"
                    android:minWidth="0dp"
                    android:text="@string/key_panel_button"
                    android:textAllCaps="false"
                    android:textColor="#F4F0E8"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/viewerLogButton"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/viewer_control_button_background"
                    android:contentDescription="@string/viewer_log_description"
                    android:minWidth="0dp"
                    android:text="@string/viewer_log_button"
                    android:textAllCaps="false"
                    android:textColor="#F4F0E8"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/viewerRotateButton"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/viewer_control_button_background"
                    android:contentDescription="@string/viewer_rotate_description"
                    android:minWidth="0dp"
                    android:text="@string/viewer_rotate_button"
                    android:textAllCaps="false"
                    android:textColor="#F4F0E8"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/viewerMenuButton"
                    android:layout_width="56dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/viewer_control_button_background"
                    android:contentDescription="@string/viewer_menu_description"
                    android:minWidth="0dp"
                    android:text="@string/viewer_menu_button"
                    android:textAllCaps="false"
                    android:textColor="#F4F0E8"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/viewerDataUsageText"
                    android:layout_width="56dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:textColor="#9AA3B2"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <include layout="@layout/viewer_key_panel" />
    </LinearLayout>
</FrameLayout>
