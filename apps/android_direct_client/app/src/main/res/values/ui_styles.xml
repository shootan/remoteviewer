<?xml version="1.0" encoding="utf-8"?>
<!-- apk-ui r1 (Codex 4): the viewer's controls. One size and one voice for every tool: a 24dp line
     icon over a short Korean label, 56dp cells (>= 48dp touch), nothing filled until pressed or
     selected. -->
<resources>
    <style name="UiRailButton">
        <item name="android:layout_width">@dimen/ui_rail_cell</item>
        <item name="android:layout_height">@dimen/ui_rail_cell</item>
        <item name="android:background">@drawable/ui_rail_button</item>
        <item name="android:drawableTint">@color/ui_text</item>
        <item name="android:drawablePadding">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- A row in a sheet: icon, label, >= 52dp tall. -->
    <style name="UiSheetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@drawable/ui_row_background</item>
        <item name="android:drawableTint">@color/ui_text</item>
        <item name="android:drawablePadding">16dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="UiSectionLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/ui_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="UiSegment">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/ui_segment_background</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="UiIconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/ui_row_background</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/ui_text</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
