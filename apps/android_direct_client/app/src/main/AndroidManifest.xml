<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        Lets the app ask the system to install an APK it downloaded. Asking is all it does: from
        API 26 the user grants this per app in settings and can take it back, and the system still
        shows its own confirmation before anything is installed. Declining either of those is an
        ordinary answer, not a failure - see UpdateDecision.isUserDecision.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Remote60AndroidDirect">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Lets the system's own install screen read the one APK this app downloaded.

            Needed because some vendors (Samsung, observed on an SM-S948N) refuse to let a
            sideloaded app install itself through PackageInstaller: the commit comes back
            "Self update is blocked by unknown source package". The same APK installs fine when the
            user is taken to the system screen, and that screen is a different process, so it needs
            a content:// URI rather than a path into this app's private storage.

            exported=false with grantUriPermissions: nothing can query this provider, and the only
            access it ever gives is the read grant attached to the install intent, for the single
            directory named in res/xml/file_paths.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updateprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
