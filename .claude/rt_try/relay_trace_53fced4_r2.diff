+             `ageMs c2hRx=${age(t.last.c2hRx)} c2hSent=${age(t.last.c2hSent)} h2cRx=${age(t.last.h2cRx)} ` +
+             `h2cSent=${age(t.last.h2cSent)} sendErr c2h=${t.sendErr.c2h} h2c=${t.sendErr.h2c} ` +
+             `lastErr=${t.lastErr || 'none'} events=[${t.events.join(' ')}]`;
