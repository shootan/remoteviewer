+      f'took={took:.1f}s ' + l[9:])
+
+ns['_ps'] = real_ps
+print(f'\n{checks} checks, {fails} failed\nRESULT: {"PASS" if fails == 0 else "FAIL"}')
+sys.exit(0 if fails == 0 else 1)
