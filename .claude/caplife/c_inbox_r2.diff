diff --git a/apps/native_poc/src/decoder_chain_inbox.hpp b/apps/native_poc/src/decoder_chain_inbox.hpp
new file mode 100644
index 0000000..be91d11
--- /dev/null
+++ b/apps/native_poc/src/decoder_chain_inbox.hpp
@@ -0,0 +1,431 @@
+#pragma once
+
+// apk-inbox C (design caplife/design_apk_decoder_inbox_r2.md r3): the decoder's bounded frame inbox that knows the
+// reference chain, and the recovery episode that asks the host for an IDR when the chain is lost. Pure logic (no
+// codec, no lock of its own -- the owner's lock covers it), shared with the Windows tests.
+//
+// ORDER. The session's UDP assembler delivers AUs in sequence order (native_video_client_shared_core.cpp
+// PopDelivery:906-915 takes the OLDEST assembly; :1058 ignores any packet not newer than the last delivered AU), so
+// the sink sees strictly increasing `seq`. The duplicate / older-than-last checks here are DEFENSIVE: what a second
+// path or a later change could feed in. Comparison: (int32_t)(b - a) > 0 means b is after a (wrap-safe within 2^31).
+// C r2 (Codex codex_apk_inbox_c_src_r1.md N3): no automatic re-ordering -- however many duplicate / older AUs come in a
+// row, they stay dropped; the order starts over only at an explicit reset (Clear: a new pick / binding / stream).
+//
+// THE INBOX (§1, §2). At most kMaxFrames frames and kMaxBytes bytes. Arriving frames:
+//   * older than or equal to the last one admitted (same generation): dropped (stale / duplicate), counted;
+//   * larger than kMaxBytes on its own: refused (oversize) -- a LOSS;
+//   * a delta while the tail gap is open (a loss happened and no usable IDR came since): refused -- it references
+//     what was lost, so it could only corrupt the picture; it is part of the same loss;
+//   * an IDR after the loss point: admitted and closes the tail gap.
+// When the inbox is over its bounds after an admit, in this order (the decision table, §1 "usable IDR"):
+//   1. an IDR in the inbox whose IDR + everything after it fits: the EARLIEST such IDR is kept with its whole suffix,
+//      everything before it goes (the older chain is skipped, not lost: decoding restarts at that IDR) -- no loss;
+//   2. an IDR in the inbox but no IDR's suffix fits: from the LAST IDR on is kept and the NEWEST frames go until it
+//      fits -- the cut is a loss at the tail (the kept IDR + its shortened suffix still decode) and the tail gap opens;
+//   3. no IDR in the inbox: everything goes (all of it continues a chain whose next reference is gone) -- a loss.
+// A loss opens the tail gap; `gapAfterSeq` is the newest AU lost, and only an IDR after it is usable.
+//
+// THE EPISODE (§2, §3, r3 보충). A chain loss opens a recovery episode (if none is open). It asks for an IDR at most
+// kMaxRequests times: the first at once, then 1 / 2 / 4 s after the previous request was actually SENT (OnSent --
+// the session calls it when the control exchange starts; a limiter refusal or a request merged into one already
+// pending is not a send). While a usable IDR is preserved (in the inbox, the decoder's pending slot, being processed)
+// nothing is asked. After the 4th send, a final window of kFinalWindowUs for the answer; then, with no usable IDR
+// preserved, the episode is EXHAUSTED: recorded once, nothing more is asked by it -- but a later usable IDR (the host's
+// periodic key) is still admitted and decoded, and its commit ends the state. Only an IDR committed to the codec
+// (CommitQueue) that comes after the loss point ends an episode; one lost again resumes the same episode with the
+// budget and deadlines it had. Invalidate() (a new pick, bind, unbind, stream reset, abort, new surface) ends it at once.
+// A want handed out and never sent (the session lost it -- not expected: held wants are retried, accepted ones sent or
+// judged stale) is handed out again after kReissueUs; that is not an attempt.
+
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <utility>
+
+namespace remote60::native_poc {
+
+inline bool chain_seq_after(uint32_t b, uint32_t a) { return static_cast<int32_t>(b - a) > 0; }
+
+struct ChainAuInfo {
+  uint64_t gen = 0;
+  uint32_t seq = 0;
+  bool key = false;
+  size_t bytes = 0;
+};
+
+enum class ChainAdmit : uint8_t {
+  Admitted = 0,
+  Duplicate,  // same generation and seq as the last admitted
+  Stale,      // same generation, older than the last admitted
+  Oversize,   // larger than the whole byte bound -- a loss
+  GapDelta,   // a delta while the tail gap is open -- part of that loss
+};
+
+struct ChainOfferResult {
+  ChainAdmit admit = ChainAdmit::Admitted;
+  bool loss = false;           // this offer lost something of the chain (a loss point moved / opened)
+  uint32_t lossSeq = 0;        // the newest AU lost by this offer (valid if loss)
+  size_t skippedFrames = 0;    // case 1: older-chain frames dropped in favour of a later IDR (no loss)
+  size_t lostFrames = 0;       // frames dropped as a loss (cases 2 / 3, oversize, gap delta)
+  // IDRs dropped by this offer whose generation has NO other IDR left in the inbox -- the caller tells the selection
+  // gate (KeyLost) for these; an IDR skipped for a later IDR of the same generation is not lost.
+  size_t keysLost = 0;
+  uint64_t keyLostGen = 0;     // the generation of the last such IDR
+};
+
+// T: the stored item; InfoFn: ChainAuInfo(const T&).
+template <class T, class InfoFn>
+class ChainInbox {
+ public:
+  ChainInbox(size_t maxFrames, size_t maxBytes, InfoFn info) : maxFrames_(maxFrames), maxBytes_(maxBytes), info_(info) {}
+
+  ChainOfferResult Offer(T&& item) {
+    ChainOfferResult r;
+    const ChainAuInfo a = info_(item);
+    if (haveLast_ && a.gen == lastGen_) {
+      if (a.seq == lastSeq_) {
+        r.admit = ChainAdmit::Duplicate;
+        ++duplicates_;
+        return r;
+      }
+      if (!chain_seq_after(a.seq, lastSeq_)) {
+        r.admit = ChainAdmit::Stale;
+        ++stale_;
+        return r;
+      }
+    }
+    haveLast_ = true;
+    lastGen_ = a.gen;
+    lastSeq_ = a.seq;
+    if (a.bytes > maxBytes_) {
+      r.admit = ChainAdmit::Oversize;
+      ++oversize_;
+      LoseOne(a, &r);
+      return r;
+    }
+    if (gapOpen_) {
+      if (!a.key) {
+        r.admit = ChainAdmit::GapDelta;
+        ++gapDeltas_;
+        LoseOne(a, &r);
+        return r;
+      }
+      gapOpen_ = false;  // an IDR after the loss point (it is newer than everything seen): usable
+    }
+    bytes_ += a.bytes;
+    items_.push_back(std::move(item));
+    if (items_.size() > maxFrames_ || bytes_ > maxBytes_) Trim(&r);
+    return r;
+  }
+
+  bool Pop(T* out) {
+    if (items_.empty()) return false;
+    const ChainAuInfo a = info_(items_.front());
+    bytes_ -= (a.bytes <= bytes_ ? a.bytes : bytes_);
+    *out = std::move(items_.front());
+    items_.pop_front();
+    return true;
+  }
+
+  // Everything goes and the order and the gap start over (a new pick / binding / stream).
+  void Clear() {
+    items_.clear();
+    bytes_ = 0;
+    gapOpen_ = false;
+    haveLast_ = false;
+  }
+
+  // A usable IDR newer than `afterSeq` is in the inbox (a candidate for the open episode).
+  bool HoldsKeyAfter(uint32_t afterSeq) const {
+    for (const T& t : items_) {
+      const ChainAuInfo a = info_(t);
+      if (a.key && chain_seq_after(a.seq, afterSeq)) return true;
+    }
+    return false;
+  }
+
+  // A loss seen outside the inbox (the decoder's own: a codec that lost its references, a delta it could not take, a
+  // frame its pending slot gave up) at `seq`. Everything queued is after `seq` (the worker takes in order).
+  // C r2 (Codex N1-a): the queued deltas up to the first IDR after `seq` reference what was lost -- they are DROPPED here
+  // (counted as lost), never handed out; the chain restarts at that IDR and its suffix is kept, no gap. With no IDR
+  // queued everything goes and the tail gap opens after the newest lost. C r2 (N1-b): `usableKeyOutside` -- an IDR after
+  // `seq` is held outside the inbox (the pending slot, going into the codec): the chain restarts there and what is
+  // queued is its suffix -- nothing dropped, no gap. -> the frames dropped.
+  size_t MarkLoss(uint32_t seq, bool usableKeyOutside = false) {
+    if (usableKeyOutside) return 0;
+    size_t dropped = 0;
+    uint32_t newest = seq;
+    while (!items_.empty()) {
+      const ChainAuInfo a = info_(items_.front());
+      if (a.key && chain_seq_after(a.seq, seq)) return dropped;
+      bytes_ -= (a.bytes <= bytes_ ? a.bytes : bytes_);
+      items_.pop_front();
+      ++dropped;
+      ++lost_;
+      ++trimmed_;
+      if (chain_seq_after(a.seq, newest)) newest = a.seq;
+    }
+    if (!gapOpen_ || chain_seq_after(newest, gapAfterSeq_)) gapAfterSeq_ = newest;
+    gapOpen_ = true;
+    return dropped;
+  }
+
+  // C r2 (Codex N1-b): an IDR went into the codec (CommitQueue). If it is after the loss the gap is open for, the chain
+  // restarted there -- the gap closes and the deltas after it are taken again. A loss after that IDR keeps its gap.
+  void OnKeyCommitted(uint32_t seq) {
+    if (gapOpen_ && chain_seq_after(seq, gapAfterSeq_)) gapOpen_ = false;
+  }
+
+  // C r2: a delta the worker took is newer than the open gap's loss point -- defensive (the trim and the door keep
+  // such a delta out of the inbox); the worker drops it instead of feeding it.
+  bool BeyondGap(uint32_t seq, bool key) const { return gapOpen_ && !key && chain_seq_after(seq, gapAfterSeq_); }
+  uint64_t trimmed() const { return trimmed_; }
+
+  // C r2: any IDR queued (the covered duty's final window: a usable IDR on its way).
+  bool HoldsAnyKey() const {
+    for (const T& t : items_) {
+      if (info_(t).key) return true;
+    }
+    return false;
+  }
+
+  size_t frames() const { return items_.size(); }
+  size_t bytes() const { return bytes_; }
+  bool empty() const { return items_.empty(); }
+  bool gapOpen() const { return gapOpen_; }
+  uint32_t gapAfterSeq() const { return gapAfterSeq_; }
+  uint64_t duplicates() const { return duplicates_; }
+  uint64_t stale() const { return stale_; }
+  uint64_t oversize() const { return oversize_; }
+  uint64_t gapDeltas() const { return gapDeltas_; }
+  uint64_t skipped() const { return skipped_; }
+  uint64_t lost() const { return lost_; }
+
+ private:
+  void NoteLoss(uint32_t seq, ChainOfferResult* r) {
+    if (!r->loss || chain_seq_after(seq, r->lossSeq)) r->lossSeq = seq;
+    r->loss = true;
+    if (!gapOpen_ || chain_seq_after(seq, gapAfterSeq_)) gapAfterSeq_ = seq;
+    gapOpen_ = true;
+  }
+  void LoseOne(const ChainAuInfo& a, ChainOfferResult* r) {
+    ++r->lostFrames;
+    ++lost_;
+    if (a.key && !HoldsKeyOfGen(a.gen)) {
+      ++r->keysLost;
+      r->keyLostGen = a.gen;
+    }
+    NoteLoss(a.seq, r);
+  }
+  bool HoldsKeyOfGen(uint64_t gen) const {
+    for (const T& t : items_) {
+      const ChainAuInfo a = info_(t);
+      if (a.key && a.gen == gen) return true;
+    }
+    return false;
+  }
+  // Drop the front item: `asLoss` (a chain loss) or skipped (an older chain left for a later IDR).
+  void DropFront(bool asLoss, ChainOfferResult* r) {
+    const ChainAuInfo a = info_(items_.front());
+    bytes_ -= (a.bytes <= bytes_ ? a.bytes : bytes_);
+    items_.pop_front();
+    CountDropped(a, asLoss, r);
+  }
+  void DropBack(ChainOfferResult* r) {
+    const ChainAuInfo a = info_(items_.back());
+    bytes_ -= (a.bytes <= bytes_ ? a.bytes : bytes_);
+    items_.pop_back();
+    CountDropped(a, true, r);
+  }
+  void CountDropped(const ChainAuInfo& a, bool asLoss, ChainOfferResult* r) {
+    if (asLoss) {
+      ++r->lostFrames;
+      ++lost_;
+      NoteLoss(a.seq, r);
+    } else {
+      ++r->skippedFrames;
+      ++skipped_;
+    }
+    if (a.key && !HoldsKeyOfGen(a.gen)) {
+      ++r->keysLost;
+      r->keyLostGen = a.gen;
+    }
+  }
+  void Trim(ChainOfferResult* r) {
+    // case 1: the earliest IDR whose IDR + suffix fits
+    size_t suffixFrames = 0, suffixBytes = 0;
+    long fit = -1, lastKey = -1;
+    for (long i = static_cast<long>(items_.size()) - 1; i >= 0; --i) {
+      const ChainAuInfo a = info_(items_[static_cast<size_t>(i)]);
+      ++suffixFrames;
+      suffixBytes += a.bytes;
+      if (!a.key) continue;
+      if (lastKey < 0) lastKey = i;
+      if (suffixFrames <= maxFrames_ && suffixBytes <= maxBytes_) fit = i;  // keeps moving to the earliest that fits
+    }
+    if (fit >= 0) {
+      for (long i = 0; i < fit; ++i) DropFront(false, r);
+      return;
+    }
+    if (lastKey >= 0) {
+      // case 2: from the last IDR on, the newest frames cut until it fits (a loss at the tail)
+      for (long i = 0; i < lastKey; ++i) DropFront(false, r);
+      while (items_.size() > maxFrames_ || bytes_ > maxBytes_) DropBack(r);
+      return;
+    }
+    // case 3: no IDR -- the whole chain in here is undecodable once its head goes
+    while (!items_.empty()) DropFront(true, r);
+  }
+
+  size_t maxFrames_;
+  size_t maxBytes_;
+  InfoFn info_;
+  std::deque<T> items_;
+  size_t bytes_ = 0;
+  bool gapOpen_ = false;
+  uint32_t gapAfterSeq_ = 0;
+  bool haveLast_ = false;
+  uint64_t lastGen_ = 0;
+  uint32_t lastSeq_ = 0;
+  uint64_t duplicates_ = 0, stale_ = 0, oversize_ = 0, gapDeltas_ = 0, skipped_ = 0, lost_ = 0, trimmed_ = 0;
+};
+
+class KeyRecoveryEpisode {
+ public:
+  static constexpr uint32_t kMaxRequests = 4;                // the first + 3 retries
+  static constexpr uint64_t kBackoffUs[kMaxRequests - 1] = {1000000ULL, 2000000ULL, 4000000ULL};
+  static constexpr uint64_t kFinalWindowUs = 4000000ULL;     // after the 4th send: its answer may still come
+  static constexpr uint64_t kReissueUs = 4000000ULL;         // a want handed out but never sent
+  enum class State : uint8_t { Idle = 0, Open, Exhausted };
+
+  // A loss of the chain after which only an IDR newer than `lossSeq` is usable. Opens an episode if none is open;
+  // an open one keeps its id, budget and deadlines (the loss point moves forward); an exhausted one stays exhausted.
+  void OnLoss(uint32_t cause, uint32_t lossSeq, uint64_t nowUs) {
+    causes_ |= cause;
+    if (state_ == State::Idle) {
+      state_ = State::Open;
+      ++id_;
+      ++opened_;
+      attempts_ = 0;
+      wantOut_ = false;
+      nextDueUs_ = 0;
+      finalDeadlineUs_ = 0;
+      openedUs_ = nowUs;
+      lossSeq_ = lossSeq;
+      causes_ = cause;
+      return;
+    }
+    if (chain_seq_after(lossSeq, lossSeq_)) lossSeq_ = lossSeq;
+  }
+
+  // A want for the session now? `candidate`: a usable IDR (after the loss point) is preserved somewhere.
+  bool TakeWant(uint64_t nowUs, bool candidate, uint64_t* episodeId) {
+    Tick(nowUs, candidate);
+    if (state_ != State::Open || candidate || attempts_ >= kMaxRequests) return false;
+    if (wantOut_) {
+      if (nowUs - wantOutUs_ < kReissueUs) return false;
+      ++reissued_;
+    } else if (attempts_ > 0 && nowUs < nextDueUs_) {
+      return false;
+    }
+    wantOut_ = true;
+    wantOutUs_ = nowUs;
+    ++wants_;
+    if (episodeId) *episodeId = id_;
+    return true;
+  }
+
+  // The session started the control exchange for a request carrying this episode.
+  void OnSent(uint64_t episodeId, uint64_t nowUs) {
+    if (state_ != State::Open || episodeId != id_ || attempts_ >= kMaxRequests) {
+      ++staleSends_;
+      return;
+    }
+    wantOut_ = false;
+    ++attempts_;
+    ++sent_;
+    if (attempts_ < kMaxRequests) {
+      nextDueUs_ = nowUs + kBackoffUs[attempts_ - 1];
+    } else {
+      finalDeadlineUs_ = nowUs + kFinalWindowUs;
+    }
+  }
+
+  // Exhausted once the 4th request's window has passed with no usable IDR preserved. true: it just became exhausted.
+  bool Tick(uint64_t nowUs, bool candidate) {
+    if (state_ != State::Open || attempts_ < kMaxRequests || candidate || nowUs < finalDeadlineUs_) return false;
+    state_ = State::Exhausted;
+    wantOut_ = false;
+    ++exhausted_;
+    return true;
+  }
+
+  // An IDR went into the codec (CommitQueue). Ends the episode (or the exhausted state) if it comes after the loss.
+  bool OnKeyCommitted(uint32_t seq) {
+    if (state_ == State::Idle || !chain_seq_after(seq, lossSeq_)) return false;
+    state_ = State::Idle;
+    wantOut_ = false;
+    ++closed_;
+    return true;
+  }
+
+  // C r2 (Codex §8 (a)): the owed duty that covered this episode is spent and its final window passed with no usable
+  // IDR preserved -- the episode is exhausted too (it never asked: owed was asking for the same IDR). true: it was open.
+  bool MarkExhausted() {
+    if (state_ != State::Open) return false;
+    state_ = State::Exhausted;
+    wantOut_ = false;
+    ++exhausted_;
+    return true;
+  }
+
+  // A new pick / binding / stream / surface, an abort: whatever was open or exhausted is moot.
+  void Invalidate() {
+    if (state_ != State::Idle) ++invalidated_;
+    state_ = State::Idle;
+    ++id_;  // a stale send / want of the old one never matches again
+    wantOut_ = false;
+    attempts_ = 0;
+    causes_ = 0;
+  }
+
+  // A want of this episode was judged moot at the send point (a usable IDR is preserved after all): no send came of
+  // it, so the next want is not held back by it (not an attempt either).
+  void OnWantDropped(uint64_t episodeId) {
+    if (episodeId == id_) wantOut_ = false;
+  }
+
+  bool StillValid(uint64_t episodeId) const { return state_ == State::Open && episodeId == id_; }
+  State state() const { return state_; }
+  uint64_t id() const { return id_; }
+  uint32_t attempts() const { return attempts_; }
+  uint32_t causes() const { return causes_; }
+  uint32_t lossSeq() const { return lossSeq_; }
+  uint64_t opened() const { return opened_; }
+  uint64_t closed() const { return closed_; }
+  uint64_t exhausted() const { return exhausted_; }
+  uint64_t invalidated() const { return invalidated_; }
+  uint64_t wants() const { return wants_; }
+  uint64_t sent() const { return sent_; }
+  uint64_t staleSends() const { return staleSends_; }
+  uint64_t reissued() const { return reissued_; }
+  const char* StateName() const {
+    return state_ == State::Idle ? "idle" : state_ == State::Open ? "open" : "exhausted";
+  }
+
+ private:
+  State state_ = State::Idle;
+  uint64_t id_ = 0;
+  uint32_t attempts_ = 0;
+  uint32_t causes_ = 0;
+  uint32_t lossSeq_ = 0;
+  bool wantOut_ = false;
+  uint64_t wantOutUs_ = 0;
+  uint64_t nextDueUs_ = 0;
+  uint64_t finalDeadlineUs_ = 0;
+  uint64_t openedUs_ = 0;
+  uint64_t opened_ = 0, closed_ = 0, exhausted_ = 0, invalidated_ = 0, wants_ = 0, sent_ = 0, staleSends_ = 0,
+           reissued_ = 0;
+};
+
+}  // namespace remote60::native_poc
diff --git a/apps/native_poc/src/decoder_chain_inbox_r2_contrast_test.cpp b/apps/native_poc/src/decoder_chain_inbox_r2_contrast_test.cpp
new file mode 100644
index 0000000..9cac2eb
--- /dev/null
+++ b/apps/native_poc/src/decoder_chain_inbox_r2_contrast_test.cpp
@@ -0,0 +1,60 @@
+// apk-inbox C r2 (Codex codex_apk_inbox_c_src_r1.md N1-a, N3): the two pure counterexamples Codex measured on 5fe90a9,
+// written ONLY with what both the r1 and the r2 header have (Offer / Pop / one-argument MarkLoss / counts) -- so the same
+// file builds against 5fe90a9's decoder_chain_inbox.hpp (REMOTE60_CHAIN_INBOX_DIR) and must FAIL there, PASS on r2.
+// Tag: pure-logic.
+//
+//   remote60_decoder_chain_inbox_r2_contrast_test
+
+#include <cstdio>
+#include <string>
+
+// <> (not ""): the header from the include path -- REMOTE60_CHAIN_INBOX_DIR first (another source in the negative runs).
+#include <decoder_chain_inbox.hpp>
+
+using namespace remote60::native_poc;
+
+namespace {
+int gFailures = 0, gChecks = 0;
+void check(const std::string& name, bool cond, const std::string& detail = {}) {
+  ++gChecks;
+  std::printf("%s  %s%s%s\n", cond ? "PASS" : "FAIL", name.c_str(), detail.empty() ? "" : "  ", detail.c_str());
+  std::fflush(stdout);
+  if (!cond) ++gFailures;
+}
+struct Au {
+  uint64_t gen = 1;
+  uint32_t seq = 0;
+  bool key = false;
+  size_t bytes = 1000;
+};
+struct AuInfo {
+  ChainAuInfo operator()(const Au& a) const { return ChainAuInfo{a.gen, a.seq, a.key, a.bytes}; }
+};
+using Inbox = ChainInbox<Au, AuInfo>;
+}  // namespace
+
+int main() {
+  std::printf("decoder_chain_inbox_r2_contrast_test (Codex's N1-a / N3 counterexamples)\n");
+  {
+    Inbox in(8, 4u << 20, AuInfo{});
+    in.Offer(Au{1, 12, false});
+    in.Offer(Au{1, 13, false});
+    in.Offer(Au{1, 14, true});
+    in.MarkLoss(11);
+    Au first;
+    const bool popped = in.Pop(&first);
+    check("N1-a: delta12, delta13, IDR14 queued, a loss at 11 -> the first Pop is IDR14 (not the broken delta12)",
+          popped && first.seq == 14 && first.key, "first=" + std::to_string(first.seq) + " key=" + std::to_string(first.key));
+  }
+  {
+    Inbox in(8, 4u << 20, AuInfo{});
+    in.Offer(Au{1, 100, false});
+    int admitted = 0;
+    for (int i = 0; i < 40; ++i) admitted += in.Offer(Au{1, 99, false}).admit == ChainAdmit::Admitted ? 1 : 0;
+    check("N3: seq 100 then 40 x seq 99: none admitted (no automatic resync)", admitted == 0,
+          "admitted=" + std::to_string(admitted));
+  }
+  std::printf("\ndecoder_chain_inbox_r2_contrast_test: %d checks, %d failed\nRESULT: %s\n", gChecks, gFailures,
+              gFailures == 0 ? "PASS" : "FAIL");
+  return gFailures == 0 ? 0 : 1;
+}
diff --git a/apps/native_poc/src/decoder_chain_inbox_test.cpp b/apps/native_poc/src/decoder_chain_inbox_test.cpp
new file mode 100644
index 0000000..86ad735
--- /dev/null
+++ b/apps/native_poc/src/decoder_chain_inbox_test.cpp
@@ -0,0 +1,377 @@
+// apk-inbox C (design caplife/design_apk_decoder_inbox_r2.md r3): the chain-aware inbox, the recovery episode and the
+// key-request descriptor (decoder_chain_inbox.hpp, decoder_key_request.hpp) -- the decision table, case by case, on
+// the pure logic. No codec, no thread, no clock: time is a number passed in. Tag: pure-logic.
+//
+//   remote60_decoder_chain_inbox_test
+
+#include <cstdio>
+#include <string>
+#include <vector>
+
+// <> (not ""): the header is taken from the include path -- REMOTE60_CHAIN_INBOX_DIR first (a mutated copy in the
+// negative runs), never this file's own directory.
+#include <decoder_chain_inbox.hpp>
+#include <decoder_key_request.hpp>
+
+using namespace remote60::native_poc;
+
+namespace {
+int gFailures = 0, gChecks = 0;
+void check(const std::string& name, bool cond, const std::string& detail = {}) {
+  ++gChecks;
+  std::printf("%s  %s%s%s\n", cond ? "PASS" : "FAIL", name.c_str(), detail.empty() ? "" : "  ", detail.c_str());
+  std::fflush(stdout);
+  if (!cond) ++gFailures;
+}
+
+struct Au {
+  uint64_t gen = 1;
+  uint32_t seq = 0;
+  bool key = false;
+  size_t bytes = 1000;
+};
+struct AuInfo {
+  ChainAuInfo operator()(const Au& a) const { return ChainAuInfo{a.gen, a.seq, a.key, a.bytes}; }
+};
+using Inbox = ChainInbox<Au, AuInfo>;
+constexpr size_t kFrames = 8;
+constexpr size_t kBytes = 4u << 20;
+Inbox make() { return Inbox(kFrames, kBytes, AuInfo{}); }
+Au d(uint32_t seq, size_t bytes = 1000, uint64_t gen = 1) { return Au{gen, seq, false, bytes}; }
+Au k(uint32_t seq, size_t bytes = 1500, uint64_t gen = 1) { return Au{gen, seq, true, bytes}; }
+std::vector<uint32_t> drain(Inbox& in) {
+  std::vector<uint32_t> out;
+  Au a;
+  while (in.Pop(&a)) out.push_back(a.seq);
+  return out;
+}
+std::string seqs(const std::vector<uint32_t>& v) {
+  std::string s;
+  for (uint32_t x : v) s += (s.empty() ? "" : ",") + std::to_string(x);
+  return s;
+}
+constexpr uint64_t S = 1000000ULL;  // one second in us
+}  // namespace
+
+int main() {
+  std::printf("decoder_chain_inbox_test (apk-inbox C: the inbox decision table, the episode, the descriptor)\n");
+
+  std::puts("\n--- inbox: order");
+  {
+    Inbox in = make();
+    bool all = true;
+    for (uint32_t s = 1; s <= 8; ++s) all = all && in.Offer(d(s)).admit == ChainAdmit::Admitted;
+    check("steady in-order frames within the bounds: all admitted, no loss, no gap", all && in.frames() == 8 &&
+          !in.gapOpen() && in.lost() == 0);
+    check("the same AU again: Duplicate, not admitted", in.Offer(d(8)).admit == ChainAdmit::Duplicate && in.frames() == 8);
+    check("an older AU (reordered): Stale, not admitted", in.Offer(d(5)).admit == ChainAdmit::Stale && in.frames() == 8);
+    check("a dropped stale / duplicate AU is no loss (no gap)", !in.gapOpen());
+  }
+  {
+    Inbox in = make();
+    const bool a = in.Offer(d(0xFFFFFFFEu)).admit == ChainAdmit::Admitted;
+    const bool b = in.Offer(d(0xFFFFFFFFu)).admit == ChainAdmit::Admitted;
+    const bool c = in.Offer(d(0u)).admit == ChainAdmit::Admitted;
+    const bool e = in.Offer(d(1u)).admit == ChainAdmit::Admitted;
+    const bool old = in.Offer(d(0xFFFFFFFFu)).admit == ChainAdmit::Stale;
+    check("wrap: ...FFFE, ...FFFF, 0, 1 in order are admitted; ...FFFF after 1 is Stale", a && b && c && e && old,
+          seqs(drain(in)));
+  }
+  {
+    // C r2 (Codex N3): no automatic re-ordering. Codex's probe on 5fe90a9: seq 100, then seq 99 x31 -> the 31st Admitted.
+    Inbox in = make();
+    in.Offer(d(100));
+    int admitted = 0;
+    for (int i = 0; i < 40; ++i) admitted += in.Offer(d(99)).admit == ChainAdmit::Admitted ? 1 : 0;
+    for (int i = 0; i < 40; ++i) admitted += in.Offer(d(100)).admit == ChainAdmit::Admitted ? 1 : 0;
+    check("N3: 40 older and 40 duplicate AUs in a row: every one dropped (no automatic resync)", admitted == 0 &&
+          in.stale() == 40 && in.duplicates() == 40, "admitted=" + std::to_string(admitted));
+    check("N3: normal increase goes on after them", in.Offer(d(101)).admit == ChainAdmit::Admitted);
+    in.Clear();  // an explicit reset (a new pick / binding / stream)
+    const bool fresh = in.Offer(k(5)).admit == ChainAdmit::Admitted && in.Offer(d(6)).admit == ChainAdmit::Admitted;
+    check("N3: after an explicit reset the order starts over at the new IDR", fresh);
+  }
+  {
+    Inbox in = make();
+    in.Offer(d(10, 1000, 1));
+    const bool newGen = in.Offer(k(3, 1500, 2)).admit == ChainAdmit::Admitted;
+    check("another generation is not ordered against the last one (the selection gate judges generations)", newGen);
+  }
+
+  std::puts("\n--- inbox: overflow, case 3 (no IDR in the inbox)");
+  {
+    Inbox in = make();
+    for (uint32_t s = 1; s <= 8; ++s) in.Offer(d(s));
+    const auto r = in.Offer(d(9));
+    check("9 deltas, no IDR: everything goes as ONE loss, the gap opens after the newest lost (9)",
+          r.loss && r.lostFrames == 9 && in.frames() == 0 && in.gapOpen() && in.gapAfterSeq() == 9,
+          "lost=" + std::to_string(r.lostFrames) + " gapAfter=" + std::to_string(in.gapAfterSeq()));
+    const auto g = in.Offer(d(10));
+    check("a delta after the loss: refused (GapDelta), the loss point moves to it, nothing enqueued",
+          g.admit == ChainAdmit::GapDelta && g.loss && in.frames() == 0 && in.gapAfterSeq() == 10);
+    const auto key = in.Offer(k(11));
+    check("the next IDR: admitted, the gap closes, it is the head", key.admit == ChainAdmit::Admitted && !key.loss &&
+          !in.gapOpen() && in.frames() == 1 && in.HoldsKeyAfter(10));
+    in.Offer(d(12));
+    check("its suffix follows", seqs(drain(in)) == "11,12");
+  }
+
+  std::puts("\n--- inbox: overflow, case 1 (an IDR + suffix fits)");
+  {
+    Inbox in = make();
+    for (uint32_t s = 1; s <= 6; ++s) in.Offer(d(s));
+    in.Offer(k(7));
+    in.Offer(d(8));
+    const auto r = in.Offer(d(9));  // 9 > 8
+    in.Offer(d(10));
+    check("6 old deltas + IDR + 3: the IDR and its whole suffix kept, the old chain skipped -- NO loss, no gap",
+          !r.loss && r.skippedFrames == 6 && r.keysLost == 0 && !in.gapOpen() && seqs(drain(in)) == "7,8,9,10",
+          "skipped=" + std::to_string(r.skippedFrames));
+  }
+  {
+    Inbox in = make();
+    in.Offer(k(1));
+    for (uint32_t s = 2; s <= 4; ++s) in.Offer(d(s));
+    in.Offer(k(5));
+    for (uint32_t s = 6; s <= 9; ++s) in.Offer(d(s));  // 9 frames: key1's suffix 9 does not fit, key5's 5 does
+    check("two IDRs, the first's suffix too long: the EARLIEST that fits (5) kept, its suffix whole; the skipped IDR "
+          "of the same generation is not 'lost'", seqs(drain(in)) == "5,6,7,8,9" && !in.gapOpen());
+  }
+  {
+    Inbox in = make();
+    in.Offer(k(1, 1500, 1));
+    in.Offer(d(2, 1000, 1));
+    in.Offer(k(3, 1500, 2));
+    for (uint32_t s = 4; s <= 8; ++s) in.Offer(d(s, 1000, 2));
+    const auto r = in.Offer(d(9, 1000, 2));
+    check("an IDR of generation 1 skipped for one of generation 2: reported lost for generation 1 (KeyLost)",
+          r.keysLost == 1 && r.keyLostGen == 1 && !r.loss);
+  }
+
+  std::puts("\n--- inbox: overflow, case 2 (an IDR, but no suffix fits)");
+  {
+    Inbox in = make();
+    in.Offer(k(1));
+    for (uint32_t s = 2; s <= 8; ++s) in.Offer(d(s));
+    const auto r = in.Offer(d(9));  // key + 8 deltas = 9
+    check("IDR + 8 deltas: the IDR and 7 kept, the newest cut -- a loss at the tail, the gap opens after it",
+          r.loss && r.lostFrames == 1 && r.lossSeq == 9 && in.gapOpen() && in.gapAfterSeq() == 9 && in.frames() == 8,
+          "frames=" + std::to_string(in.frames()));
+    check("a delta after that: refused", in.Offer(d(10)).admit == ChainAdmit::GapDelta);
+    check("the next IDR: admitted (the bounds trim the oldest chain for it)", in.Offer(k(11)).admit == ChainAdmit::Admitted);
+    const auto out = drain(in);
+    check("the IDR is kept and goes in after... nothing older than a decodable chain", !out.empty() && out.back() == 11,
+          seqs(out));
+  }
+  {
+    Inbox in = make();
+    in.Offer(k(1, 3u << 20));
+    const auto r = in.Offer(d(2, 1536u << 10));  // 3 MiB + 1.5 MiB > 4 MiB
+    check("bytes: an IDR of 3 MiB and a delta of 1.5 MiB: the delta cut (a loss), the IDR kept, <= 4 MiB",
+          r.loss && in.frames() == 1 && in.bytes() <= kBytes && in.gapOpen());
+  }
+
+  std::puts("\n--- inbox: oversize");
+  {
+    Inbox in = make();
+    const auto r = in.Offer(k(1, (4u << 20) + 1));
+    check("an IDR over the whole byte bound: refused, a loss, its generation's IDR lost, the gap opens",
+          r.admit == ChainAdmit::Oversize && r.loss && r.keysLost == 1 && in.gapOpen() && in.frames() == 0);
+    check("a delta after it: refused", in.Offer(d(2)).admit == ChainAdmit::GapDelta);
+  }
+
+  std::puts("\n--- inbox: a loss seen outside it (MarkLoss)");
+  {
+    Inbox in = make();
+    in.Offer(d(1));
+    in.MarkLoss(1);
+    check("the decoder lost its chain at 1: the gap opens, the next delta is refused", in.gapOpen() &&
+          in.Offer(d(2)).admit == ChainAdmit::GapDelta);
+    in.Offer(k(3));
+    check("an IDR closes it", !in.gapOpen());
+  }
+  {
+    Inbox in = make();
+    in.Offer(d(10));
+    in.Offer(k(11));
+    in.Offer(d(12));
+    in.MarkLoss(10);
+    check("a loss at 10 with an IDR (11) already held after it: no gap -- 13 continues 11's chain", !in.gapOpen() &&
+          in.Offer(d(13)).admit == ChainAdmit::Admitted);
+  }
+
+  {
+    // C r2 (Codex N1-a): Codex's counterexample on 5fe90a9 -- delta12, delta13, IDR14 queued, MarkLoss(11): the first Pop
+    // was delta12 (key 0, gap 0): the broken suffix handed out ahead of the recovery IDR.
+    Inbox in = make();
+    in.Offer(d(12));
+    in.Offer(d(13));
+    in.Offer(k(14));
+    in.Offer(d(15));
+    const size_t dropped = in.MarkLoss(11);
+    Au first;
+    const bool popped = in.Pop(&first);
+    check("N1-a: a loss at 11 with delta12, delta13 queued before IDR14: they are dropped, the first Pop is IDR14, no gap",
+          dropped == 2 && popped && first.seq == 14 && first.key && !in.gapOpen() && seqs(drain(in)) == "15",
+          "dropped=" + std::to_string(dropped) + " first=" + std::to_string(first.seq));
+  }
+  {
+    Inbox in = make();
+    in.Offer(d(12));
+    in.Offer(d(13));
+    const size_t dropped = in.MarkLoss(11);
+    check("N1-a: no IDR queued after the loss: every queued delta dropped, the gap opens after the newest (13)",
+          dropped == 2 && in.frames() == 0 && in.gapOpen() && in.gapAfterSeq() == 13 &&
+              in.Offer(d(14)).admit == ChainAdmit::GapDelta);
+  }
+  {
+    Inbox in = make();
+    in.Offer(d(4));
+    in.Offer(d(5));
+    const size_t dropped = in.MarkLoss(2, true);
+    check("N1-b: a usable IDR (3) held outside the inbox: the queued 4, 5 are its suffix -- kept, no gap",
+          dropped == 0 && !in.gapOpen() && seqs(drain(in)) == "4,5");
+  }
+  {
+    Inbox in = make();
+    in.MarkLoss(2);
+    in.OnKeyCommitted(3);
+    const bool closed = !in.gapOpen() && in.Offer(d(4)).admit == ChainAdmit::Admitted;
+    Inbox later = make();
+    later.MarkLoss(2);
+    later.Offer(d(9));  // refused: the gap moves to 9
+    later.OnKeyCommitted(3);
+    check("N1-b: an IDR committed after the gap's loss point closes it (4 admitted); one committed BEFORE a later loss "
+          "(9) leaves that loss's gap", closed && later.gapOpen() && later.gapAfterSeq() == 9);
+  }
+
+  std::puts("\n--- episode: schedule");
+  {
+    KeyRecoveryEpisode e;
+    e.OnLoss(kKeyCauseRecovery, 9, 0);
+    uint64_t id = 0;
+    const bool w0 = e.TakeWant(0, false, &id);
+    const bool again = e.TakeWant(10, false, nullptr);
+    check("a loss opens ONE episode; its first want at once; no second want until it is sent", w0 && !again &&
+          e.state() == KeyRecoveryEpisode::State::Open && e.opened() == 1);
+    e.OnSent(id, 0);
+    const bool early = e.TakeWant(S - 1, false, nullptr);
+    const bool due1 = e.TakeWant(S, false, nullptr);
+    e.OnSent(id, S);
+    const bool early2 = e.TakeWant(3 * S - 1, false, nullptr);
+    const bool due2 = e.TakeWant(3 * S, false, nullptr);
+    e.OnSent(id, 3 * S);
+    const bool due3 = e.TakeWant(7 * S, false, nullptr);
+    e.OnSent(id, 7 * S);
+    const bool fifth = e.TakeWant(8 * S, false, nullptr);
+    check("sends at t0, +1, +3, +7 s (1 / 2 / 4 s after the previous SEND), nothing earlier, no 5th",
+          !early && due1 && !early2 && due2 && due3 && !fifth && e.attempts() == 4 && e.sent() == 4);
+    const bool notYet = e.Tick(11 * S - 1, false);
+    const bool ex = e.Tick(11 * S, false);
+    check("exhausted only after the final window (4 s after the 4th send)", !notYet && ex &&
+          e.state() == KeyRecoveryEpisode::State::Exhausted && e.exhausted() == 1);
+    e.OnLoss(kKeyCauseRecovery, 30, 12 * S);
+    check("a loss while exhausted: no new episode, no want", e.state() == KeyRecoveryEpisode::State::Exhausted &&
+          !e.TakeWant(20 * S, false, nullptr) && e.opened() == 1);
+    check("a later IDR committed after the loss point ends it (the host's periodic key)", e.OnKeyCommitted(31) &&
+          e.state() == KeyRecoveryEpisode::State::Idle);
+  }
+  {
+    KeyRecoveryEpisode e;
+    e.OnLoss(kKeyCauseRecovery, 9, 0);
+    uint64_t id = 0;
+    e.TakeWant(0, false, &id);
+    const bool refusedNoSend = !e.TakeWant(500000, false, nullptr) && e.attempts() == 0;
+    check("a want the session could not send (limiter): not an attempt, not handed out again early", refusedNoSend);
+    check("... handed out again only after kReissueUs", !e.TakeWant(KeyRecoveryEpisode::kReissueUs - 1, false, nullptr) &&
+          e.TakeWant(KeyRecoveryEpisode::kReissueUs, false, nullptr) && e.reissued() == 1 && e.attempts() == 0);
+  }
+
+  {
+    KeyRecoveryEpisode e;
